{
  "name": "mopsa-wasm",
  "version": "0.1.0",
  "description": "MOPSA static analyzer compiled to WebAssembly",
  "type": "module",
  "main": "dist/mopsa_worker.js",
  "packageManager": "pnpm@9.0.0",
  "browser": {
    "path": "path-browserify",
    "stream": "stream-browserify",
